{
  "bsonType": "object",
  "required": ["content"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "文档 ID"
    },
    "content": {
      "bsonType": "string",
      "title": "帖子文本内容"
    },
    "image_url": {
      "bsonType": "string",
      "title": "帖子附图"
    },
    "linked_cat_id": {
      "bsonType": "string",
      "title": "关联的猫咪ID"
    },
    "linked_cat_name": {
      "bsonType": "string",
      "title": "关联的猫咪名称"
    },
    "location_name": {
      "bsonType": "string",
      "title": "发布时所在位置名称"
    },
    "user_id": {
      "bsonType": "string",
      "title": "发布者ID"
    },
    "author_name": {
      "bsonType": "string",
      "title": "发布者昵称"
    },
    "author_avatar": {
      "bsonType": "string",
      "title": "发布者头像"
    },
    "create_time": {
      "bsonType": "timestamp",
      "title": "发布时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
	"last_update_time":{
		"bsonType": "timestamp",
      "title": "最后更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
	},
	"like_account":{
		"bsonType": "int",
		"title":"点赞人数"
	},
	"favorite_account":{
		"bsonType": "int",
		"title": "收藏人数"
	},
	"comment_account":{
		"bsonType": "int",
		"title":"评论人数"
	},
	"like_users":{
		"bsonType": "array",
		"title": "点赞用户ID列表",
		  "items": {
		    "bsonType": "string"
		  }
	},
	"favorite_users": {
	      "bsonType": "array",
	      "title": "收藏用户ID列表",
	      "items": {
	        "bsonType": "string"
	      }
	},
	"comments":{
		"bsonType": "array",
      "title": "评论列表",
      "items": {
        "bsonType": "object",
			"properties": {
				"comment_id": {
					"bsonType": "string",
					"title": "评论ID"
				},
				"comment_content": {
					"bsonType": "string",
					"title": "评论内容"
				},
				"comment_author_id": {
					"bsonType": "string",
					"title": "评论者ID"
				},
				"comment_author_name": {
					"bsonType": "string",
					"title":"评论者昵称"
				},
				"comment_author_avatar": {
					"bsonType": "string",
					"title": "评论者头像（新增：用于渲染头像）"
				},
				"parent_id":{
					"bsonType":"string",
					"title":"楼主评论ID,顶层评论此属性为空"
				},
				"reply_to_id": {
					"bsonType":"string",
					"title":"被回复的评论ID，顶层评论为空"
				},
				"likes":{
					"bsonType":"int",
					"title":"评论点赞数"
				},
				"like_users":{
					"bsonType":"array",
					"title":"点赞用户ID",
					"items":{
						"bsonType":"string"
					}
				},
				"create_time": {
					"bsonType": "timestamp",
					"title": "评论时间"
				}
			}
}
}
}
}